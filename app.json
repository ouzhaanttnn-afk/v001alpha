{
  "expo": {
    "name": "Cepkaynak",
    "slug": "cepkaynak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mihenkaynak/legacy_app_icon_composition.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cepkaynak.app"
    },
    "android": {
      "package": "com.cepkaynak.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/mihenkaynak/legacy_app_icon_composition.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
